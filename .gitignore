# Environment
.venv/
__pycache__/
*.pyc
*.egg-info/

# Local configuration; segmentation.example.toml is the committed reference.
segmentation.toml

# Third-party source, cloned not vendored (see README for the clone command)
sam3/

# Source recordings
*.mp4
*.avi
*.mov
*.mkv

# Generated outputs: re-derivable from the source video via the pipeline.
