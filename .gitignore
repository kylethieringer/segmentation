# un-ignore a specific run with:  git add -f runs/<name>/tracks.csv
runs/
figures/

# Local validation only, deliberately untracked
make_figures.py
build_report.py

# Design specs and implementation plans: working notes, not part of the tool
docs/superpowers/

# IDE
.idea/
